---
import Layout from "../layouts/Layout.astro";
import CatalogueFilters from "../components/CatalogueFilters.astro";
import ProductCard from "../components/ProductCard.astro";
import Icon from "../components/Icon.astro";
import { MOIS_NOMS } from "../lib/mois";
import { moisCourant } from "../lib/saison";
import produitsJson from "../data/produits.json";
import type { Produit } from "../lib/types";

const produits = produitsJson as Produit[];
const lettreDe = (nom: string) => nom.normalize("NFD").replace(/\p{Diacritic}/gu, "").charAt(0).toUpperCase();

// Produits déjà triés par ordre alphabétique (scripts/build-data.mjs) : on les regroupe par initiale
const groupes = new Map<string, Produit[]>();
for (const p of produits) {
  const l = lettreDe(p.nom);
  groupes.set(l, [...(groupes.get(l) ?? []), p]);
}
---

<Layout title="De saison — tous les fruits et légumes, de A à Z" description="Tous les fruits et légumes de A à Z : de saison ou non, prix en supermarché, en bio et au marché.">
  <section class="intro">
    <h1 class="titre-page">Fruits &amp; légumes de A à Z</h1>
    <p class="sous-titre-page">
      <Icon name="calendar" size={16} /> En <strong data-mois-courant>{MOIS_NOMS[moisCourant() - 1]}</strong>, repérez d'un coup d'œil ce qui est de saison.
    </p>
  </section>

  <div class="barre-filtres">
    <CatalogueFilters />
  </div>

  <div data-catalogue>
    {
      [...groupes].map(([lettre, liste]) => (
        <section class="groupe" data-groupe aria-labelledby={`lettre-${lettre}`}>
          <h2 class="groupe__lettre" id={`lettre-${lettre}`}>{lettre}</h2>
          <div class="grille">
            {liste.map((p) => (
              <ProductCard produit={p} />
            ))}
          </div>
        </section>
      ))
    }

    <div class="vide" data-vide hidden>
      <p><strong>Aucun produit ne correspond.</strong></p>
      <p>Vérifiez l'orthographe, ou proposez-nous de l'ajouter.</p>
      <div class="vide__actions">
        <button type="button" class="btn" data-reinitialiser>Effacer les filtres</button>
        <a class="btn btn--fantome" href="/suggestions">Suggérer un produit</a>
      </div>
    </div>
  </div>
</Layout>

<script>
  import "../scripts/catalogue";
</script>

<style>
  .intro {
    margin-bottom: var(--space-md);
  }

  .intro :global(.icon) {
    margin-top: -3px;
  }

  .barre-filtres {
    margin-bottom: var(--space-lg);
  }

  .groupe {
    margin-bottom: var(--space-lg);
    scroll-margin-top: 80px;
  }

  .groupe__lettre {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: var(--text-sm);
    color: var(--color-encre-douce);
    margin: 0 0 var(--space-xs);
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .groupe__lettre::after {
    content: "";
    flex: 1;
    border-top: var(--border-dashed);
    opacity: 0.4;
  }

  .grille {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-sm);
  }

  .vide {
    text-align: center;
    padding: var(--space-xl) var(--space-md);
    border: var(--border-dashed);
    border-radius: var(--radius-md);
    background: var(--color-papier);
  }

  .vide p {
    margin: 0 0 var(--space-xs);
  }

  .vide__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-xs);
    margin-top: var(--space-md);
  }

  @media (min-width: 640px) {
    .grille {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .grille {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
