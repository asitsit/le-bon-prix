---
interface Props {
  produits: Array<{ slug: string; nom: string; alias: string[] }>;
}

const { produits } = Astro.props;

// Index allégé transmis au client : seuls les champs nécessaires à la recherche
const indexData = produits.map((p) => ({
  slug: p.slug,
  nom: p.nom,
  alias: p.alias.join(" "),
}));
---

<div class="search">
  <span class="search__icon" aria-hidden="true">🔍</span>
  <input
    type="search"
    id="search-input"
    class="search__input"
    placeholder="Tomate, pomme, poireau..."
    aria-label="Rechercher un fruit ou légume"
    autocomplete="off"
  />
</div>

<div class="filters" role="group" aria-label="Filtrer par type">
  <button type="button" class="filter" data-type="tous" aria-pressed="true">Tous</button>
  <button type="button" class="filter" data-type="fruit" aria-pressed="false">Fruits</button>
  <button type="button" class="filter" data-type="legume" aria-pressed="false">Légumes</button>
</div>

<script type="application/json" id="search-index-data" set:html={JSON.stringify(indexData)} />

<script>
  import Fuse from "fuse.js";

  const dataEl = document.getElementById("search-index-data");
  const indexData = JSON.parse(dataEl?.textContent ?? "[]");

  const fuse = new Fuse(indexData, {
    keys: ["nom", "alias"],
    threshold: 0.15,
    ignoreDiacritics: true,
  });

  const input = document.getElementById("search-input") as HTMLInputElement;
  const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>(".filter"));
  let currentType = "tous";

  const allCards = () => Array.from(document.querySelectorAll<HTMLElement>("[data-slug]"));

  function applyFilter() {
    const query = input?.value.trim() ?? "";
    const cards = allCards();
    const matchedSlugs = query ? new Set(fuse.search(query).map((r) => r.item.slug)) : null;
    const filtreActif = Boolean(query) || currentType !== "tous";

    cards.forEach((card) => {
      const matchesQuery = !matchedSlugs || matchedSlugs.has(card.dataset.slug ?? "");
      const matchesType = currentType === "tous" || card.dataset.type === currentType;
      card.hidden = !(matchesQuery && matchesType);
    });

    // En mode recherche/filtre, on masque les titres de section pour ne montrer qu'une liste plate
    document.querySelectorAll("[data-section]").forEach((s) => ((s as HTMLElement).hidden = filtreActif));
  }

  let debounceTimer: ReturnType<typeof setTimeout>;
  input?.addEventListener("input", () => {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(applyFilter, 100);
  });

  filterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      currentType = button.dataset.type ?? "tous";
      filterButtons.forEach((b) => b.setAttribute("aria-pressed", String(b === button)));
      applyFilter();
    });
  });
</script>

<style>
  .search {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    background: var(--color-papier);
    border: 1.5px solid var(--color-ardoise);
    border-radius: var(--radius-sm);
    padding: 0 var(--space-sm);
    height: var(--tap-target);
  }

  .search__icon {
    font-size: 1.1rem;
    line-height: 1;
  }

  .search__input {
    flex: 1;
    border: none;
    background: transparent;
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--color-encre);
    height: 100%;
  }

  .search__input:focus {
    outline: none;
  }

  .search__input::placeholder {
    color: #8a8368;
  }

  .filters {
    display: flex;
    gap: var(--space-xs);
    margin-top: var(--space-sm);
  }

  .filter {
    min-height: var(--tap-target);
    padding: 0 var(--space-md);
    border: 1.5px solid var(--color-ardoise);
    border-radius: 20px;
    background: transparent;
    color: var(--color-encre);
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--text-sm);
    cursor: pointer;
    transition: background var(--dur-fast) ease, color var(--dur-fast) ease;
  }

  .filter[aria-pressed="true"] {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-papier);
  }
</style>
