# Copier en .env (local) ou définir dans Vercel > Settings > Environment Variables.

# Formulaire de suggestions : URL d'un service d'envoi de formulaires qui accepte un POST JSON
# (ex. Formspree : créer un formulaire sur https://formspree.io, coller l'URL https://formspree.io/f/xxxxxxx).
# Par défaut le site utilise https://formspree.io/f/myeekkaw. Mettre une valeur vide : le bouton "Envoyer" ouvre alors un e-mail pré-rempli vers PUBLIC_CONTACT_EMAIL.
PUBLIC_SUGGESTIONS_ENDPOINT=https://formspree.io/f/myeekkaw

# Adresse de repli (et affichée en cas d'échec d'envoi)
PUBLIC_CONTACT_EMAIL=contact@de-saison.fr
