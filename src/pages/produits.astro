---
import Layout from "../layouts/Layout.astro";
import SearchBar from "../components/SearchBar.astro";
import ProductMiniCard from "../components/ProductMiniCard.astro";
import { calculerStatutSaison } from "../lib/saison";
import { MOIS_NOMS } from "../lib/mois";
import produits from "../data/produits.json";

const moisCourant = new Date().getMonth() + 1;

const produitsDeSaison = produits.filter(
  (p) => calculerStatutSaison(p.mois_saison).statut === "de_saison"
);
const produitsRestants = produits
  .filter((p) => calculerStatutSaison(p.mois_saison).statut !== "de_saison")
  .sort((a, b) => a.nom.localeCompare(b.nom));
---

<Layout title="Voir les prix — De saison" description="Recherchez un fruit ou un légume et découvrez s'il est de saison.">
  <section class="search-section">
    <h1>Qu'est-ce qui est de saison ?</h1>
    <SearchBar produits={produits} />
  </section>

  <section data-section class="section">
    <h2>De saison en {MOIS_NOMS[moisCourant - 1]}</h2>
    <div class="grid">
      {produitsDeSaison.map((p) => (
        <div data-slug={p.slug} data-type={p.type}>
          <ProductMiniCard produit={p} />
        </div>
      ))}
    </div>
  </section>

  <section data-section class="section">
    <h2>Tous les fruits et légumes</h2>
    <div class="grid">
      {produitsRestants.map((p) => (
        <div data-slug={p.slug} data-type={p.type}>
          <ProductMiniCard produit={p} />
        </div>
      ))}
    </div>
  </section>
</Layout>

<style>
  .search-section {
    margin-bottom: var(--space-xl);
  }

  .search-section h1 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-2xl);
    margin: 0 0 var(--space-md);
  }

  .section {
    margin-bottom: var(--space-xl);
  }

  .section h2 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-lg);
    margin: 0 0 var(--space-md);
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-sm);
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
