---
import { calculerStatutSaison } from "../lib/saison";

interface Props {
  moisSaison: number[];
  productionEurope?: boolean;
  taille?: "sm" | "md";
}

const { moisSaison, productionEurope = true, taille = "sm" } = Astro.props;

// Rendu initial à la date du build ; scripts/saison-client.ts le recalcule à la date du visiteur
const { statut, label } = calculerStatutSaison(moisSaison, undefined, productionEurope);
---

<span
  class={`badge badge--${statut} badge--${taille}`}
  data-saison
  data-mois={moisSaison.join(",")}
  data-europe={productionEurope ? "1" : "0"}
>
  <span class="badge__dot" aria-hidden="true"></span>
  <span data-saison-label>{label}</span>
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: var(--text-xs);
    font-weight: 500;
    border-radius: 999px;
    padding: 2px 8px 2px 7px;
    white-space: nowrap;
    width: fit-content;
  }

  .badge--md {
    font-size: var(--text-sm);
    padding: 4px 12px 4px 10px;
  }

  .badge__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    display: inline-block;
    background: currentColor;
  }

  .badge--de_saison {
    color: var(--color-saison-ok-text);
    background: var(--color-saison-ok-bg);
  }

  .badge--bientot {
    color: var(--color-saison-bientot);
    background: var(--color-saison-bientot-bg);
  }

  .badge--hors_saison,
  .badge--importe {
    color: var(--color-saison-non-text);
    background: var(--color-saison-non-bg);
  }
</style>
