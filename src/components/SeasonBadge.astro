---
import { calculerStatutSaison } from "../lib/saison";

interface Props {
  moisSaison: number[];
  productionEurope?: boolean;
}

const { moisSaison, productionEurope = true } = Astro.props;

const { statut, label } = productionEurope
  ? calculerStatutSaison(moisSaison)
  : { statut: "importe" as const, label: "importé" };
---

<span class={`badge badge--${statut}`}>
  <span class="badge__dot" aria-hidden="true"></span>
  {label}
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: var(--text-xs);
    font-weight: 500;
  }

  .badge__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    display: inline-block;
  }

  .badge--de_saison {
    color: var(--color-saison-ok);
  }
  .badge--de_saison .badge__dot {
    background: var(--color-saison-ok);
  }

  .badge--bientot {
    color: var(--color-saison-bientot);
  }
  .badge--bientot .badge__dot {
    background: var(--color-saison-bientot);
  }

  .badge--hors_saison,
  .badge--importe {
    color: var(--color-saison-non);
  }
  .badge--hors_saison .badge__dot,
  .badge--importe .badge__dot {
    background: var(--color-saison-non);
  }
</style>
