---
import Layout from "../layouts/Layout.astro";
import Icon, { type NomIcone } from "../components/Icon.astro";
import produitsJson from "../data/produits.json";
import type { Produit } from "../lib/types";

const produits = produitsJson as Produit[];

// Formulaire Formspree (POST JSON). Surchargeable via PUBLIC_SUGGESTIONS_ENDPOINT (.env ou Vercel) ;
// une valeur vide ouvre à la place un e-mail pré-rempli.
const endpoint = import.meta.env.PUBLIC_SUGGESTIONS_ENDPOINT ?? "https://formspree.io/f/myeekkaw";
const emailContact = import.meta.env.PUBLIC_CONTACT_EMAIL ?? "contact@de-saison.fr";

const SUJETS: Array<{ valeur: string; label: string; icone: NomIcone }> = [
  { valeur: "nouveau-produit", label: "Ajouter un produit", icone: "plus" },
  { valeur: "erreur-prix", label: "Un prix me semble faux", icone: "store" },
  { valeur: "erreur-saison", label: "Erreur de saison", icone: "calendar" },
  { valeur: "idee", label: "Une idée pour le site", icone: "bulb" },
];
---

<Layout title="Suggestions — De saison" description="Un produit manquant, un prix étrange, une idée ? Écrivez-nous.">
  <div class="page">
    <section class="intro">
      <h1 class="titre-page">Une suggestion ?</h1>
      <p class="sous-titre-page">
        Un produit manquant, un prix qui vous semble loin de la réalité, une idée : on lit tout.
      </p>
    </section>

    <form class="form" data-form-suggestion data-endpoint={endpoint} data-email={emailContact} novalidate>
      <fieldset class="champ">
        <legend class="champ__label">C'est à propos de…</legend>
        <div class="sujets">
          {
            SUJETS.map((s, i) => (
              <label class="sujet">
                <input type="radio" name="sujet" value={s.valeur} checked={i === 0} />
                <span class="sujet__carte">
                  <Icon name={s.icone} size={20} />
                  {s.label}
                </span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <label class="champ">
        <span class="champ__label">Produit concerné <span class="champ__opt">(facultatif)</span></span>
        <input class="champ__input" name="produit" list="liste-produits" placeholder="Ex. tomate, ou un produit absent du site" maxlength="80" />
        <datalist id="liste-produits">
          {produits.map((p) => <option value={p.nom} />)}
        </datalist>
      </label>

      <label class="champ">
        <span class="champ__label">Votre message</span>
        <textarea class="champ__input champ__input--texte" name="message" rows="5" required minlength="10" maxlength="2000" placeholder="Dites-nous tout…"></textarea>
        <span class="champ__erreur" data-erreur-message hidden>Quelques mots de plus (10 caractères minimum).</span>
      </label>

      <label class="champ">
        <span class="champ__label">Votre e-mail <span class="champ__opt">(facultatif, pour vous répondre)</span></span>
        <input class="champ__input" type="email" name="email" autocomplete="email" inputmode="email" maxlength="120" placeholder="vous@exemple.fr" />
        <span class="champ__erreur" data-erreur-email hidden>Cette adresse e-mail ne semble pas valide.</span>
      </label>

      <!-- Piège à robots : champ invisible pour un humain -->
      <label class="pot-de-miel" aria-hidden="true">
        Ne pas remplir <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
      </label>

      <button type="submit" class="btn btn--accent envoyer" data-envoyer>
        <Icon name="send" size={18} /> Envoyer
      </button>

      <p class="form__note">
        Votre e-mail sert uniquement à vous répondre. Il n'est ni conservé à d'autres fins, ni partagé.
      </p>
    </form>

    <div class="merci" data-merci hidden tabindex="-1">
      <span class="merci__icone"><Icon name="check" size={32} /></span>
      <h2>Merci !</h2>
      <p>Votre suggestion est bien arrivée. On la regarde au plus vite.</p>
      <button type="button" class="btn" data-nouvelle>Envoyer une autre suggestion</button>
    </div>

    <p class="erreur-envoi" data-erreur-envoi role="alert" hidden>
      L'envoi n'a pas abouti. Réessayez dans un instant, ou écrivez-nous à
      <a href={`mailto:${emailContact}`}>{emailContact}</a>.
    </p>
  </div>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-form-suggestion]")!;
  const merci = document.querySelector<HTMLElement>("[data-merci]")!;
  const erreurEnvoi = document.querySelector<HTMLElement>("[data-erreur-envoi]")!;
  const bouton = form.querySelector<HTMLButtonElement>("[data-envoyer]")!;
  const endpoint = form.dataset.endpoint ?? "";

  // Lien depuis une fiche produit : /suggestions?produit=Tomate&sujet=erreur-prix
  const params = new URLSearchParams(location.search);
  const champProduit = form.elements.namedItem("produit") as HTMLInputElement;
  if (params.get("produit")) champProduit.value = params.get("produit")!;
  const radioSujet = form.querySelector<HTMLInputElement>(`input[name="sujet"][value="${CSS.escape(params.get("sujet") ?? "")}"]`);
  if (radioSujet) radioSujet.checked = true;

  function valider(): boolean {
    const message = form.elements.namedItem("message") as HTMLTextAreaElement;
    const email = form.elements.namedItem("email") as HTMLInputElement;
    const okMessage = message.value.trim().length >= 10;
    const okEmail = !email.value || email.checkValidity();
    form.querySelector<HTMLElement>("[data-erreur-message]")!.hidden = okMessage;
    form.querySelector<HTMLElement>("[data-erreur-email]")!.hidden = okEmail;
    message.setAttribute("aria-invalid", String(!okMessage));
    email.setAttribute("aria-invalid", String(!okEmail));
    if (!okMessage) message.focus();
    else if (!okEmail) email.focus();
    return okMessage && okEmail;
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    erreurEnvoi.hidden = true;
    if (!valider()) return;

    const donnees = Object.fromEntries(new FormData(form)) as Record<string, string>;
    if (donnees._gotcha) return; // robot

    const sujet = form.querySelector<HTMLInputElement>('input[name="sujet"]:checked')?.parentElement?.textContent?.trim() ?? "Suggestion";

    if (!endpoint) {
      // Pas de service configuré : on ouvre la messagerie de l'utilisateur avec un e-mail pré-rempli
      const corps = `${donnees.message}\n\nProduit : ${donnees.produit || "—"}\nE-mail : ${donnees.email || "—"}`;
      location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(`[De saison] ${sujet}`)}&body=${encodeURIComponent(corps)}`;
      return;
    }

    bouton.disabled = true;
    bouton.setAttribute("aria-busy", "true");
    try {
      const res = await fetch(endpoint, {
        method: "POST",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify({ ...donnees, _subject: `[De saison] ${sujet}`, page: document.referrer || location.href }),
      });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      form.hidden = true;
      merci.hidden = false;
      merci.focus();
    } catch {
      erreurEnvoi.hidden = false;
    } finally {
      bouton.disabled = false;
      bouton.removeAttribute("aria-busy");
    }
  });

  document.querySelector("[data-nouvelle]")!.addEventListener("click", () => {
    merci.hidden = true;
    form.hidden = false;
  });
</script>

<style>
  .page {
    max-width: 560px;
    margin: 0 auto;
  }

  .intro {
    margin-bottom: var(--space-lg);
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    background: var(--color-papier);
    border: var(--border-dashed);
    border-radius: var(--radius-lg);
    padding: var(--space-lg) var(--space-md);
  }

  .champ {
    display: flex;
    flex-direction: column;
    gap: 6px;
    border: none;
    margin: 0;
    padding: 0;
    min-width: 0;
  }

  .champ__label {
    font-weight: 600;
    font-size: var(--text-sm);
    padding: 0;
    margin-bottom: 2px;
  }

  .champ__opt {
    font-weight: 400;
    color: var(--color-encre-pale);
  }

  .champ__input {
    width: 100%;
    min-height: 48px;
    padding: var(--space-sm);
    border: 1.5px solid var(--color-ardoise);
    border-radius: var(--radius-sm);
    background: #fff;
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--color-encre);
  }

  .champ__input:focus {
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
  }

  .champ__input[aria-invalid="true"] {
    border-color: var(--color-accent);
  }

  .champ__input--texte {
    resize: vertical;
    min-height: 140px;
    line-height: 1.5;
  }

  .champ__erreur {
    font-size: var(--text-xs);
    color: var(--color-accent-fonce);
    font-weight: 500;
  }

  .sujets {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xs);
  }

  .sujet input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .sujet__carte {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    min-height: 84px;
    padding: var(--space-sm);
    border: 1.5px solid var(--color-kraft-fonce);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    font-weight: 500;
    line-height: 1.3;
    cursor: pointer;
    background: #fff;
    transition: border-color var(--dur-fast) ease, background var(--dur-fast) ease;
  }

  .sujet input:checked + .sujet__carte {
    border-color: var(--color-ardoise);
    background: var(--color-kraft);
  }

  .sujet input:focus-visible + .sujet__carte {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .pot-de-miel {
    position: absolute;
    left: -9999px;
  }

  .envoyer {
    align-self: stretch;
  }

  .envoyer[aria-busy="true"] {
    opacity: 0.7;
    cursor: progress;
  }

  .form__note {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--color-encre-douce);
  }

  .merci {
    text-align: center;
    padding: var(--space-xl) var(--space-md);
    background: var(--color-papier);
    border: var(--border-dashed);
    border-radius: var(--radius-lg);
  }

  .merci__icone {
    display: inline-grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--color-saison-ok);
    color: var(--color-papier);
  }

  .merci h2 {
    font-family: var(--font-display);
    font-weight: 600;
    margin: var(--space-sm) 0 var(--space-xs);
  }

  .erreur-envoi {
    margin-top: var(--space-md);
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-sm);
    background: #fbe3df;
    color: var(--color-accent-fonce);
    font-size: var(--text-sm);
  }

  @media (min-width: 640px) {
    .form {
      padding: var(--space-xl);
    }

    .sujets {
      grid-template-columns: repeat(4, 1fr);
    }

    .envoyer {
      align-self: flex-start;
    }
  }
</style>
