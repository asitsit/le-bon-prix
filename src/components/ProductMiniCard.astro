---
import SeasonBadge from "./SeasonBadge.astro";

import { estProduitEnEurope } from "../lib/origine";

interface Props {
  produit: {
    slug: string;
    nom: string;
    icone: string;
    mois_saison: number[];
    production_europe: string;
  };
}

const { produit } = Astro.props;
---

<a href={`/produit/${produit.slug}`} class="mini-card">
  <span class="mini-card__icone" aria-hidden="true">{produit.icone}</span>
  <span class="mini-card__nom">{produit.nom}</span>
  <SeasonBadge moisSaison={produit.mois_saison} productionEurope={estProduitEnEurope(produit.production_europe)} />
</a>

<style>
  .mini-card {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    min-height: var(--tap-target);
    background: var(--color-papier);
    border: var(--border-dashed);
    border-radius: var(--radius-sm);
    padding: var(--space-xs) var(--space-sm);
    text-decoration: none;
    color: var(--color-encre);
    transition: transform var(--dur-fast) ease, border-color var(--dur-fast) ease;
  }

  .mini-card:hover,
  .mini-card:focus-visible {
    transform: translateY(-2px);
    border-color: var(--color-accent);
  }

  .mini-card__icone {
    font-size: 1.5rem;
    line-height: 1;
  }

  .mini-card__nom {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-base);
    flex: 1;
  }
</style>
