---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import { estProduitEnEurope } from "../lib/origine";
import { formatEuros, prixPrincipal, SERIES } from "../lib/prix";
import produitsJson from "../data/produits.json";
import type { Produit } from "../lib/types";

const produits = produitsJson as Produit[];

// Index allégé transmis au navigateur : de quoi afficher la liste sans recharger toutes les fiches
const index = produits.map((p) => {
  const principal = prixPrincipal(p);
  return {
    slug: p.slug,
    nom: p.nom,
    image: p.image,
    mois: p.mois_saison,
    europe: estProduitEnEurope(p.production_europe),
    prix: principal
      ? `${formatEuros(principal.prix.valeur)}/${principal.prix.unite} · ${SERIES[principal.serie].label.toLowerCase()}`
      : "",
  };
});
---

<Layout title="Ma liste de courses — De saison" description="Votre liste de fruits et légumes, enregistrée sur cet appareil.">
  <section class="intro">
    <h1 class="titre-page">Ma liste de courses</h1>
    <p class="sous-titre-page">
      <Icon name="info" size={16} /> Enregistrée sur cet appareil uniquement, sans compte.
    </p>
  </section>

  <div class="liste" data-liste-page>
    <div class="liste__barre" data-liste-barre hidden>
      <p class="liste__resume" data-liste-resume></p>
      <div class="liste__actions">
        <button type="button" class="btn btn--fantome btn--petit" data-liste-partager>
          <Icon name="share" size={18} /> Partager
        </button>
        <button type="button" class="btn btn--fantome btn--petit" data-liste-vider>
          <Icon name="trash" size={18} /> Vider
        </button>
      </div>
    </div>

    <ul class="liste__items" data-liste-items></ul>

    <h2 class="liste__sous-titre" data-liste-titre-panier hidden>
      <Icon name="check" size={18} /> Dans le panier
    </h2>
    <ul class="liste__items liste__items--coches" data-liste-coches></ul>

    <div class="vide" data-liste-vide hidden>
      <span class="vide__icone"><Icon name="basket" size={40} /></span>
      <p><strong>Votre liste est vide.</strong></p>
      <p>Ajoutez des produits avec le bouton <span class="vide__plus"><Icon name="plus" size={14} /></span> depuis le catalogue.</p>
      <div class="vide__actions">
        <a href="/de-saison" class="btn btn--accent"><Icon name="leaf" size={18} /> Voir ce qui est de saison</a>
        <a href="/" class="btn">Tous les produits</a>
      </div>
    </div>

    <p class="liste__toast" data-liste-toast role="status" hidden></p>
  </div>

  <template id="tpl-item">
    <li class="item">
      <label class="item__coche">
        <input type="checkbox" data-item-coche />
        <span class="item__case" aria-hidden="true"></span>
      </label>
      <a class="item__lien" data-item-lien>
        <img class="item__img" data-item-img width="48" height="48" alt="" loading="lazy" />
        <span class="item__corps">
          <span class="item__nom" data-item-nom></span>
          <span class="item__meta">
            <span class="badge" data-saison data-item-badge>
              <span class="badge__dot" aria-hidden="true"></span><span data-saison-label></span>
            </span>
            <span class="item__prix" data-item-prix></span>
          </span>
        </span>
      </a>
      <button type="button" class="item__suppr" data-item-suppr>
        <Icon name="x" size={18} />
      </button>
    </li>
  </template>

  <script type="application/json" id="index-liste" set:html={JSON.stringify(index)} />
</Layout>

<script>
  import { lireListe, ecrireListe, surChangement, type ArticleListe } from "../scripts/liste-client";
  import { appliquerSaison } from "../scripts/saison-client";

  interface Entree {
    slug: string;
    nom: string;
    image: string | null;
    mois: number[];
    europe: boolean;
    prix: string;
  }

  const index: Entree[] = JSON.parse(document.getElementById("index-liste")?.textContent ?? "[]");
  const parSlug = new Map(index.map((e) => [e.slug, e]));
  const tpl = document.getElementById("tpl-item") as HTMLTemplateElement;
  const ulItems = document.querySelector<HTMLUListElement>("[data-liste-items]")!;
  const ulCoches = document.querySelector<HTMLUListElement>("[data-liste-coches]")!;
  const titrePanier = document.querySelector<HTMLElement>("[data-liste-titre-panier]")!;
  const barre = document.querySelector<HTMLElement>("[data-liste-barre]")!;
  const resume = document.querySelector<HTMLElement>("[data-liste-resume]")!;
  const vide = document.querySelector<HTMLElement>("[data-liste-vide]")!;
  const toast = document.querySelector<HTMLElement>("[data-liste-toast]")!;

  function afficherToast(message: string) {
    toast.textContent = message;
    toast.hidden = false;
    setTimeout(() => (toast.hidden = true), 2500);
  }

  function creerItem(article: ArticleListe, e: Entree): HTMLLIElement {
    const li = tpl.content.firstElementChild!.cloneNode(true) as HTMLLIElement;
    li.dataset.slug = e.slug;
    li.classList.toggle("is-coche", article.coche);
    const coche = li.querySelector<HTMLInputElement>("[data-item-coche]")!;
    coche.checked = article.coche;
    coche.setAttribute("aria-label", `${e.nom} : ${article.coche ? "dans le panier" : "à acheter"}`);
    const lien = li.querySelector<HTMLAnchorElement>("[data-item-lien]")!;
    lien.href = `/produit/${e.slug}`;
    const img = li.querySelector<HTMLImageElement>("[data-item-img]")!;
    if (e.image) img.src = e.image;
    else img.remove();
    li.querySelector("[data-item-nom]")!.textContent = e.nom;
    li.querySelector("[data-item-prix]")!.textContent = e.prix;
    const badge = li.querySelector<HTMLElement>("[data-item-badge]")!;
    badge.className = "badge badge--hors_saison";
    badge.dataset.mois = e.mois.join(",");
    badge.dataset.europe = e.europe ? "1" : "0";
    li.querySelector("[data-item-suppr]")!.setAttribute("aria-label", `Retirer ${e.nom} de la liste`);
    return li;
  }

  function rendre(liste: ArticleListe[] = lireListe()) {
    const valides = liste.filter((a) => parSlug.has(a.slug));
    const aAcheter = valides.filter((a) => !a.coche);
    const coches = valides.filter((a) => a.coche);

    ulItems.replaceChildren(...aAcheter.map((a) => creerItem(a, parSlug.get(a.slug)!)));
    ulCoches.replaceChildren(...coches.map((a) => creerItem(a, parSlug.get(a.slug)!)));
    appliquerSaison(undefined, document.querySelector("[data-liste-page]")!);

    titrePanier.hidden = coches.length === 0;
    barre.hidden = valides.length === 0;
    vide.hidden = valides.length > 0;
    resume.textContent =
      valides.length === 0
        ? ""
        : `${aAcheter.length} à acheter${coches.length ? ` · ${coches.length} dans le panier` : ""}`;
  }

  document.querySelector("[data-liste-page]")!.addEventListener("change", (ev) => {
    const input = ev.target as HTMLInputElement;
    if (!input.matches("[data-item-coche]")) return;
    const slug = input.closest<HTMLElement>("[data-slug]")?.dataset.slug;
    ecrireListe(lireListe().map((a) => (a.slug === slug ? { ...a, coche: input.checked } : a)));
  });

  document.querySelector("[data-liste-page]")!.addEventListener("click", (ev) => {
    const btn = (ev.target as Element).closest("[data-item-suppr]");
    if (!btn) return;
    const slug = btn.closest<HTMLElement>("[data-slug]")?.dataset.slug;
    ecrireListe(lireListe().filter((a) => a.slug !== slug));
  });

  document.querySelector("[data-liste-vider]")!.addEventListener("click", () => {
    if (confirm("Vider toute la liste ?")) ecrireListe([]);
  });

  document.querySelector("[data-liste-partager]")!.addEventListener("click", async () => {
    const lignes = lireListe()
      .filter((a) => parSlug.has(a.slug))
      .map((a) => `${a.coche ? "✓" : "☐"} ${parSlug.get(a.slug)!.nom}`);
    const texte = `Ma liste de courses (De saison)\n${lignes.join("\n")}`;
    try {
      if (navigator.share) {
        await navigator.share({ title: "Ma liste de courses", text: texte });
      } else {
        await navigator.clipboard.writeText(texte);
        afficherToast("Liste copiée dans le presse-papiers");
      }
    } catch {
      // Partage annulé par l'utilisateur : rien à faire
    }
  });

  surChangement(rendre);
  rendre();
</script>

<style>
  .intro {
    margin-bottom: var(--space-lg);
  }

  .intro :global(.icon) {
    margin-top: -3px;
  }

  .liste {
    max-width: 640px;
  }

  .liste__barre {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-bottom: var(--space-sm);
  }

  .liste__resume {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-encre-douce);
  }

  .liste__actions {
    display: flex;
    gap: 4px;
  }

  .btn--petit {
    min-height: var(--tap-target);
    padding: 0 var(--space-sm);
    font-size: var(--text-sm);
  }

  .liste__items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .liste__sous-titre {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    margin: var(--space-lg) 0 var(--space-sm);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-base);
    color: var(--color-encre-douce);
  }

  .item {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    background: var(--color-papier);
    border: var(--border-dashed);
    border-radius: var(--radius-md);
    padding: 4px;
    transition: opacity var(--dur-base) ease;
  }

  .item.is-coche {
    opacity: 0.6;
  }

  .item.is-coche .item__nom {
    text-decoration: line-through;
  }

  .item__coche {
    flex-shrink: 0;
    width: var(--tap-target);
    height: var(--tap-target);
    display: grid;
    place-items: center;
    cursor: pointer;
    position: relative;
  }

  .item__coche input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }

  .item__case {
    width: 24px;
    height: 24px;
    border: 1.5px solid var(--color-ardoise);
    border-radius: 6px;
    display: grid;
    place-items: center;
    background: var(--color-papier);
    transition: background var(--dur-fast) ease;
  }

  .item__coche input:checked + .item__case {
    background: var(--color-saison-ok);
    border-color: var(--color-saison-ok);
  }

  .item__coche input:checked + .item__case::after {
    content: "";
    width: 6px;
    height: 11px;
    border: solid var(--color-papier);
    border-width: 0 2px 2px 0;
    transform: translateY(-1px) rotate(45deg);
  }

  .item__coche input:focus-visible + .item__case {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .item__lien {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    text-decoration: none;
    color: inherit;
    min-height: var(--tap-target);
  }

  .item__img {
    width: 48px;
    height: 48px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .item__corps {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .item__nom {
    font-family: var(--font-display);
    font-weight: 600;
  }

  .item__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 8px;
  }

  .item__prix {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-encre-douce);
  }

  .item__suppr {
    flex-shrink: 0;
    width: var(--tap-target);
    height: var(--tap-target);
    display: grid;
    place-items: center;
    border: none;
    border-radius: 50%;
    background: transparent;
    color: var(--color-encre-douce);
    cursor: pointer;
  }

  .item__suppr:hover {
    background: var(--color-kraft);
    color: var(--color-accent);
  }

  /* Badge de saison (même rendu que SeasonBadge.astro, appliqué à des éléments créés en JS) */
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: var(--text-xs);
    font-weight: 500;
    border-radius: 999px;
    padding: 1px 8px 1px 7px;
  }

  .badge__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
  }

  :global(.badge--de_saison) {
    color: var(--color-saison-ok-text);
    background: var(--color-saison-ok-bg);
  }

  :global(.badge--bientot) {
    color: var(--color-saison-bientot);
    background: var(--color-saison-bientot-bg);
  }

  :global(.badge--hors_saison),
  :global(.badge--importe) {
    color: var(--color-saison-non-text);
    background: var(--color-saison-non-bg);
  }

  .vide {
    text-align: center;
    padding: var(--space-xl) var(--space-md);
    border: var(--border-dashed);
    border-radius: var(--radius-lg);
    background: var(--color-papier);
  }

  .vide__icone {
    display: inline-grid;
    place-items: center;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: var(--color-kraft);
    margin-bottom: var(--space-sm);
  }

  .vide p {
    margin: 0 0 var(--space-xs);
  }

  .vide__plus {
    display: inline-grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 1.5px solid var(--color-ardoise);
    vertical-align: middle;
  }

  .vide__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-xs);
    margin-top: var(--space-md);
  }

  .liste__toast {
    position: fixed;
    left: 50%;
    bottom: calc(var(--nav-mobile) + var(--space-md) + env(safe-area-inset-bottom));
    transform: translateX(-50%);
    background: var(--color-ardoise);
    color: var(--color-papier);
    padding: var(--space-xs) var(--space-md);
    border-radius: 999px;
    font-size: var(--text-sm);
    margin: 0;
    z-index: 40;
  }

  @media (min-width: 840px) {
    .liste__toast {
      bottom: var(--space-lg);
    }
  }
</style>
